# .env.example
#
# Copy to .env.local and fill in real values for local development.
# NEVER commit .env.local. NEVER commit real secrets to the repo.
# Production secrets are managed in the Vercel project dashboard.

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Canonical site URL. Used for OG metadata, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://newyorktitans.org

# -----------------------------------------------------------------------------
# Email (Resend) — required for forms
# -----------------------------------------------------------------------------
# Get your key from https://resend.com/api-keys
# Sending domain MUST be mail.newyorktitans.org with verified SPF/DKIM/DMARC.
RESEND_API_KEY=

# Inbound routing addresses. These are the operator inboxes that receive
# inquiries. They should be Google Workspace groups, not individual mailboxes.
INQUIRIES_INBOX=inquiries@newyorktitans.org
PARTNERSHIPS_INBOX=partnerships@newyorktitans.org

# Outbound sender identity. Auto-responders are sent from this address.
NOREPLY_SENDER=New York Titans <noreply@mail.newyorktitans.org>

# -----------------------------------------------------------------------------
# Analytics (Plausible)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=newyorktitans.org

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Window in seconds; default 30. Increase only if real traffic warrants it.
FORM_RATE_LIMIT_WINDOW_SECONDS=30
FORM_RATE_LIMIT_MAX=1
