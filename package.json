{
  "name": "newyorktitans-web",
  "version": "0.1.0",
  "private": true,
  "description": "New York Titans — nonprofit/community-first cricket organization website.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,json}\"",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test --project=visual-regression",
    "test:visual:update": "playwright test --project=visual-regression --update-snapshots",
    "test:a11y": "playwright test --project=accessibility",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun && lhci assert --config=lighthouserc.lcp-ratchet.json",
    "prebuild": "pnpm validate:content && pnpm typecheck",
    "preinstall": "npx only-allow pnpm",
    "check": "pnpm typecheck && pnpm lint && pnpm validate:content && pnpm test"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.0",
    "@phosphor-icons/react": "2.1.7",
    "clsx": "2.1.1",
    "framer-motion": "11.11.0",
    "next": "14.2.35",
    "next-mdx-remote": "6.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.0",
    "resend": "4.0.0",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "1.48.0",
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitest/ui": "2.1.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.2"
  }
}
